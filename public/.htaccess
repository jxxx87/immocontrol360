# Marketing-Website immocontrol360.de (liegt im kombinierten Deploy im Root des production-Branches).
# Liegt die Web-App als Unterordner /app (app.immocontrol360.de) darunter, gelten die Header-Regeln
# voraussichtlich auch dort. Sie sind mit der App abgeglichen: keine Kamera-/Mikrofon-/Standort-/USB-Nutzung,
# keine Einbettung in fremde Seiten. Die Rewrite-Regeln der App stehen in deren eigener .htaccess.
# HTTP -> HTTPS leitet Hostinger bereits selbst weiter (301); bewusst keine eigene Regel hier,
# damit hinter dem Hostinger-CDN keine Weiterleitungsschleife entstehen kann.

# Echte 404 statt "Soft-404" (Komplett-Check W1c-19): Nur die Routen aus src/App.jsx liefern index.html
# mit Status 200 (Regel unten). Alle anderen fehlenden Pfade – auch alte Build-Dateien unter /assets/ –
# beantwortet der Server mit Status 404; als Seite dient ebenfalls index.html, React zeigt dort die
# Seite "Diese Seite gibt es nicht" (NotFound, noindex).
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # www.immocontrol360.de dauerhaft auf die Hauptdomain umleiten (Pfad und Query-String bleiben erhalten).
  # Keine Schleife möglich: Das Ziel beginnt nicht mit "www.". Die App-Subdomain ist nicht betroffen.
  RewriteCond %{HTTP_HOST} ^www\.immocontrol360\.de\.?(:[0-9]+)?$ [NC]
  RewriteRule ^(.*)$ https://immocontrol360.de/$1 [R=301,L]

  RewriteRule ^index\.html$ - [L]

  # Bekannte Seiten der React-App -> index.html (Status 200). "/" liefert index.html direkt (DirectoryIndex).
  # WICHTIG: Liste synchron mit den Routen in src/App.jsx halten – eine neue Route, die hier fehlt,
  # wird zwar angezeigt, antwortet aber mit Status 404 (Suchmaschinen nehmen sie dann nicht auf).
  # Groß-/Kleinschreibung und abschließender Schrägstrich sind wie bei React Router egal.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(preise|funktionen|faq|landing|investor|billing/success|billing/cancel|paywall|impressum|datenschutz|agb|abo-starten|checkout|register-trial|login)/?$ /index.html [NC,L]
</IfModule>

<IfModule mod_headers.c>
  # Sicherheits-Header
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"
  # HSTS 180 Tage, bewusst ohne includeSubDomains und ohne preload
  Header always set Strict-Transport-Security "max-age=15552000"

  # HTML immer beim Server nachfragen, damit ein neuer Deploy sofort ankommt.
  # "always": gilt auch für die 404-Antwort (index.html als ErrorDocument), damit kein Cache sie festhält.
  <FilesMatch "\.html?$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>

  # Von Vite gehashte Build-Dateien (assets/name-HASH.ext, 8-stelliger Hash) ändern ihren Namen bei jeder
  # Änderung und dürfen daher ein Jahr unverändert zwischengespeichert werden.
  # Achtung: eigene Dateien in public/ nicht nach dem Muster "name-XXXXXXXX.png" benennen.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|mjs|css|woff2?|ttf|otf|png|jpe?g|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
