# Vorlage für die lokale .env der Marketing-Website (Werte NICHT hier eintragen, .env wird nicht eingecheckt).
# Nur VITE_-Variablen landen im Browser-Bundle – hier daher ausschließlich öffentliche Werte.

# Supabase-Projekt (Kontaktformular -> Edge Function "contact-form", siehe src/components/siteConfig.js)
VITE_SUPABASE_URL=
# Öffentlicher anon-Key des Supabase-Projekts
VITE_SUPABASE_ANON_KEY=

# VITE_STRIPE_PUBLISHABLE_KEY wird von der Website nicht verwendet (Zahlung läuft in der App) und kann entfallen.
